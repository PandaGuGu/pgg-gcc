int OP_PUSHL=2;
int OP_STORE=3;
int OP_BINOP=4;
int OP_CMP=5;
int OP_JZ=6;
int OP_JNZ=7;
int OP_JMP=8;
int OP_LBL=9;
int g_am=0;
int wd(int at,int n){ if(n/10!=0){ at=wd(at,n/10); } eb[at]='0'+(n-(n/10)*10); return at+1; }
void ml(){ int i,j,k; i=0;
eb[0]='e'; eb[1]='r'; eb[2]='r'; eb[3]='o'; eb[4]='r'; eb[5]=':'; eb[6]=' '; i=7;
i=wd(i,tp); eb[i]=' '; i=i+1;
k=tl; if(k>8){ k=8; }
j=0; while(j<k){ if(tp+j<src_len){ eb[i]=src_buf[tp+j]; i=i+1; } j=j+1; }
eb[i]=0; }
void se(){ ml(); print_err(eb); exit(2); }
void ie(){ ml(); print_err(eb); exit(1); }
void ostr(char *s){ if(irc>=131072){ ie(); } irv[irc]=s; irt[irc]=0; irc=irc+1; }
void oint(int v){ if(irc>=131072){ ie(); } irv[irc]=v; irt[irc]=1; irc=irc+1; }
void irop(int op, int a){ if(irc>=131070){ ie(); } irv[irc]=op; irt[irc]=2; irc=irc+1; irv[irc]=a; irt[irc]=1; irc=irc+1; }
void irgo(){ int i; int op; int a;
i=0;
while(i<irc){
 if(irt[i]==0){ print_str(irv[i]); i=i+1; }
 else if(irt[i]==2){ op=irv[i]; a=0; i=i+1;
  if(i<irc){ if(irt[i]==1){ a=irv[i]; i=i+1; } }
  if(op==OP_PUSHI){ if(g_am==1){ print_str("    pushq $"); print_int(a); print_str("\n"); } else { print_str("    pushl $"); print_int(a); print_str("\n"); } }
  else if(op==OP_PUSHL){ if(g_am==1){ print_str("    pushq "); print_int(a); print_str("(%rbp)\n"); } else { print_str("    pushl "); print_int(a); print_str("(%ebp)\n"); } }
  else if(op==OP_STORE){ if(g_am==1){ print_str("    popq %rax\n    movq %rax, "); print_int(a); print_str("(%rbp)\n    pushq %rax\n"); } else { print_str("    popl %eax\n    movl %eax, "); print_int(a); print_str("(%ebp)\n    pushl %eax\n"); } }
  else if(op==OP_JZ){ if(g_am==1){ print_str("    popq %rax\n    testq %rax, %rax\n    jz L"); print_int(a); print_str("\n"); } else { print_str("    popl %eax\n    testl %eax, %eax\n    jz L"); print_int(a); print_str("\n"); } }
  else if(op==OP_JNZ){ if(g_am==1){ print_str("    popq %rax\n    testq %rax, %rax\n    jnz L"); print_int(a); print_str("\n"); } else { print_str("    popl %eax\n    testl %eax, %eax\n    jnz L"); print_int(a); print_str("\n"); } }
  else if(op==OP_JMP){ print_str("    jmp L"); print_int(a); print_str("\n"); }
  else if(op==OP_LBL){ print_str("L"); print_int(a); print_str(":\n"); }
  else if(op==OP_BINOP){
   if(g_am==1){
    if(a==T_PLUS){ print_str("    popq %rcx\n    popq %rax\n    addq %rcx, %rax\n    pushq %rax\n"); }
    else if(a==T_MINUS){ print_str("    popq %rcx\n    popq %rax\n    subq %rcx, %rax\n    pushq %rax\n"); }
    else if(a==T_STAR){ print_str("    popq %rcx\n    popq %rax\n    imulq %rcx, %rax\n    pushq %rax\n"); }
    else if(a==T_SLASH){ print_str("    popq %rcx\n    popq %rax\n    cqto\n    idivq %rcx\n    pushq %rax\n"); }
    else if(a==T_PERCENT){ print_str("    popq %rcx\n    popq %rax\n    cqto\n    idivq %rcx\n    pushq %rdx\n"); }
    else if(a==T_BAND){ print_str("    popq %rcx\n    popq %rax\n    andq %rcx, %rax\n    pushq %rax\n"); }
    else if(a==T_BOR){ print_str("    popq %rcx\n    popq %rax\n    orq %rcx, %rax\n    pushq %rax\n"); }
    else if(a==T_XOR){ print_str("    popq %rcx\n    popq %rax\n    xorq %rcx, %rax\n    pushq %rax\n"); }
    else if(a==T_SHL){ print_str("    popq %rcx\n    popq %rax\n    shlq %cl, %rax\n    pushq %rax\n"); }
    else if(a==T_SHR){ print_str("    popq %rcx\n    popq %rax\n    shrq %cl, %rax\n    pushq %rax\n"); }
    else if(a==T_UN){ print_str("    popq %rax\n    negq %rax\n    pushq %rax\n"); }
    else if(a==T_NOT){ print_str("    popq %rax\n    testq %rax, %rax\n    sete %al\n    movzbq %al, %rax\n    pushq %rax\n"); }
