if(t==T_SHR){ print_str("    popl %ecx\n    popl %eax\n    shrl %cl, %eax\n    pushl %eax\n"); }
if(t==T_UN){ print_str("    popl %eax\n    negl %eax\n    pushl %eax\n"); }
if(t==T_NOT){ print_str("    popl %eax\n    testl %eax, %eax\n    sete %al\n    movzbl %al, %eax\n    pushl %eax\n"); }
if(t==T_TILDE){ print_str("    popl %eax\n    notl %eax\n    pushl %eax\n"); }
if(t==T_AND){ print_str("    popl %ecx\n    popl %eax\n    andl %ecx, %eax\n    testl %eax, %eax\n    setne %al\n    movzbl %al, %eax\n    pushl %eax\n"); }
if(t==T_OR){ print_str("    popl %ecx\n    popl %eax\n    orl %ecx, %eax\n    testl %eax, %eax\n    setne %al\n    movzbl %al, %eax\n    pushl %eax\n"); } }
void em_cm(int t){
if(t==T_EQ){ print_str("    popl %ecx\n    popl %eax\n    cmpl %ecx, %eax\n    sete %al\n"); print_str("    movzbl %al, %eax\n    pushl %eax\n"); }
