void ecpy(int sz){ int i;
i=0;
while(i<sz){
 if(i+4<=sz){
  print_str("    movl "); print_int(i); print_str("(%ecx), %eax\n");
  print_str("    movl %eax, "); print_int(i); print_str("(%edx)\n");
  i=i+4;
 } else {
  print_str("    movb "); print_int(i); print_str("(%ecx), %al\n");
  print_str("    movb %al, "); print_int(i); print_str("(%edx)\n");
  i=i+1;
 } }
}
