int T_END=0,T_NUM=1,T_PLUS=2,T_MINUS=3,T_STAR=4,T_SLASH=5,T_LPAREN=6,T_RPAREN=7,T_UN=8,T_ID=9,T_ASSIGN=10,T_SEMI=11,T_COMMA=12,T_INT=13,T_RETURN=14,T_LBRACE=15,T_RBRACE=16,T_EQ=17,T_NE=18,T_LT=19,T_LE=20,T_GT=21,T_GE=22,T_IF=23,T_ELSE=24,T_WHILE=25,T_FOR=26,T_DO=27,T_BREAK=28,T_CONTINUE=29,T_CHAR=30,T_LBKT=31,T_RBKT=32,T_NOT=33,T_AND=34,T_OR=35,T_STR=36,T_CHR=37,T_VOID=38,T_CONST=39,T_VOLATILE=40,T_QMARK=41,T_COLON=42,T_SIZEOF=43,T_PERCENT=44,T_BAND=45,T_BOR=46,T_XOR=47,T_TILDE=48,T_SHL=49,T_SHR=50,T_SWITCH=51,T_CASE=52,T_DEFAULT=53,T_ENUM=54,T_TYPEDEF=55,T_DEREF=56,T_DOT=57,T_ARROW=58,T_STRUCT=59,T_UNION=60;
