void pginit(int dty,int sid){ int k; int mt;
/* 初始化器递归解析：tk 初值 = 值序列开头（调用方已越过顶层 '{'）。
   dty: 0=int 数组层 / 1=char 数组层 / 2+=struct 实例（sid=struct id）。
   数组层遇嵌套 '{' 递归同 dty；struct 层按字段类型输出 .long/.byte。 */
if(dty>=2){
 k=0;
 while(1){
  if(tk==T_LBRACE){ nx(); pginit(2,sms[sid*8+k]); }
  else {
   if(tk!=T_NUM){ se(); }
   mt=smt[sid*8+k];
   if(mt==1){ print_str("    .byte "); print_int(tv); print_str("\n"); }
   else { print_str("    .long "); print_int(tv); print_str("\n"); }
   nx();
  }
  k=k+1;
  if(tk==T_RBRACE){ nx(); break; }
  if(tk!=T_COMMA){ se(); }
  nx();
 }
} else {
 while(1){
  if(tk==T_LBRACE){ nx(); pginit(dty,-1); }
  else {
   if(tk!=T_NUM){ se(); }
   if(dty==1){ print_str("    .byte "); print_int(tv); print_str("\n"); }
   else { print_str("    .long "); print_int(tv); print_str("\n"); }
   nx();
  }
  if(tk==T_RBRACE){ nx(); break; }
  if(tk!=T_COMMA){ se(); }
  nx();
 }
}
}
